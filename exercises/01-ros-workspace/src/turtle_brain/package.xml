<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_brain</name>
  <version>0.1.0</version>
  <description>A minimal ROS 2 node that drives turtlesim using PyTorch.</description>
  <maintainer email="hi@prefix.dev">Prefix.dev</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- PyTorch comes from the Pixi workspace (pytorch / pytorch-gpu), not rosdep. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
